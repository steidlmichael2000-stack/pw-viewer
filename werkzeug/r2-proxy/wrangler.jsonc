// Nur für „npx wrangler deploy" aus diesem Ordner. Wer den Worker über das
// Dashboard einfügt, legt die Bindung dort an (siehe README.md).
{
  "name": "pwviewer-daten",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "pointclouds" }
  ]
}
